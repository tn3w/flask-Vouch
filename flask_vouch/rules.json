[
    {
        "name": "cloudflare-workers",
        "action": "DENY",
        "headers": { "CF-Worker": ".*" }
    },
    {
        "name": "known-bad",
        "action": "DENY",
        "user_agent": "(?i:Sogou|MJ12bot|AhrefsBot|SemrushBot|DotBot|BLEXBot|DataForSeoBot|Bytedance|SerpstatBot|MegaIndex|Seekport|ZoominfoBot|magpie-crawler|Barkrowler|SeznamBot|LinkpadBot|spbot|VelenPublicWebCrawler)"
    },
    {
        "name": "vuln-scanners",
        "action": "DENY",
        "user_agent": "(?i:Nmap|Nikto|sqlmap|ZmEu|masscan|WPScan|Acunetix|Nessus|dirbuster|nuclei|gobuster|feroxbuster|wfuzz|ffuf|httpx|Qualys|OpenVAS|zgrab|CensysInspect|InternetMeasurement|l9scan|Expanse)"
    },
    {
        "name": "wp-scanners",
        "action": "DENY",
        "path": "(?i:wp-login|wp-admin|xmlrpc\\.php|wp-config)"
    },
    {
        "name": "cms-probes",
        "action": "DENY",
        "path": "(?i:/phpmyadmin|/pma/|/adminer|/administrator/|/typo3/|/wp-content/(?:uploads|plugins)/.*\\.php|/wp-json/wp/v2/users)"
    },
    {
        "name": "framework-leak-probes",
        "action": "DENY",
        "path": "(?i:/actuator(?:/|$)|/_profiler/|/server-status|/server-info|/\\.vscode/|/\\.idea/|/config\\.(?:json|yml|yaml)$|/composer\\.(?:json|lock)$|/package-lock\\.json$|/\\.npmrc$|/credentials$)"
    },
    {
        "name": "dotfile-probes",
        "action": "DENY",
        "path": "/\\.(env|git|svn|hg|bzr|htaccess|htpasswd|DS_Store|aws|ssh|bash_history|netrc)"
    },
    {
        "name": "shell-probes",
        "action": "DENY",
        "path": "(?i:\\.(php|cgi|asp|aspx|jsp)$|/cgi-bin/|/shell|/cmd)"
    },
    {
        "name": "traversal-attempts",
        "action": "DENY",
        "path": "(\\.\\./|%2e%2e|%252e)"
    },
    {
        "name": "injection-attempts",
        "action": "DENY",
        "path": "(?i:union(?:\\s|%20|\\+)+select|/etc/passwd|\\bjava\\.lang\\.|\\$\\{jndi:|<script|%3cscript|/bin/(?:sh|bash))"
    },
    {
        "name": "well-known",
        "action": "ALLOW",
        "path": "^/\\.well-known/"
    },
    {
        "name": "favicon",
        "action": "ALLOW",
        "path": "^/favicon\\.ico$"
    },
    {
        "name": "robots-txt",
        "action": "ALLOW",
        "path": "^/robots\\.txt$"
    },
    {
        "name": "site-metadata",
        "action": "ALLOW",
        "path": "^/(sitemap(?:[\\w-]*)?\\.xml|sitemap_index\\.xml|ads\\.txt|app-ads\\.txt|humans\\.txt|apple-app-site-association|manifest\\.json|browserconfig\\.xml)$"
    },
    {
        "name": "health-checks",
        "action": "ALLOW",
        "path": "^/(healthz?|readyz?|livez?|ping|status)$"
    },
    {
        "name": "search-engines",
        "action": "ALLOW",
        "user_agent": "(?i:Googlebot|Bingbot|DuckDuckBot|Baiduspider|YandexBot|Applebot)"
    },
    {
        "name": "feed-readers",
        "action": "ALLOW",
        "user_agent": "(?i:Feedly|NewsBlur|Miniflux|FreshRSS|Inoreader|Feedbin|Tiny Tiny RSS)"
    },
    {
        "name": "monitoring",
        "action": "ALLOW",
        "user_agent": "(?i:UptimeRobot|Pingdom|StatusCake|Better Uptime|Checkly)"
    },
    {
        "name": "link-previews",
        "action": "ALLOW",
        "user_agent": "(?i:Slackbot|Discordbot|Twitterbot|facebookexternalhit|LinkedInBot|WhatsApp|TelegramBot)"
    },
    {
        "name": "archive-org",
        "action": "ALLOW",
        "user_agent": "(?i:archive\\.org_bot|Wayback)"
    },
    {
        "name": "ai-bots",
        "action": "CHALLENGE",
        "difficulty": 14,
        "user_agent": "(?i:GPTBot|ChatGPT|Claude-Web|ClaudeBot|Anthropic|CCBot|Google-Extended|Bytespider|PetalBot|Diffbot|Cohere-ai|PerplexityBot|YouBot|Amazonbot|Meta-ExternalAgent|Applebot-Extended|Timpibot|ImagesiftBot|OAI-SearchBot)"
    },
    {
        "name": "headless-browsers",
        "action": "CHALLENGE",
        "difficulty": 12,
        "user_agent": "(?i:HeadlessChrome|PhantomJS|Playwright|Puppeteer|Selenium|electron|cypress|Nightmare|SlimerJS)"
    },
    {
        "name": "aggressive-scrapers",
        "action": "CHALLENGE",
        "difficulty": 12,
        "user_agent": "(?i:Scrapy|colly|HttpClient|python-requests|aiohttp|httpx|urllib|Go-http-client|Java/|libwww-perl|mechanize|node-fetch|axios|okhttp|Guzzle|reqwest|got\\s|undici)"
    },
    {
        "name": "empty-ua",
        "action": "CHALLENGE",
        "user_agent": "^$"
    },
    {
        "name": "generic-browser",
        "action": "CHALLENGE",
        "user_agent": "Mozilla"
    },
    {
        "name": "ip-blocklist",
        "action": "CHALLENGE",
        "blocklist": true
    },
    {
        "name": "bogon-origin",
        "action": "CHALLENGE",
        "bogon_ip": true
    },
    {
        "name": "crawler",
        "action": "CHALLENGE",
        "crawler": true
    },
    {
        "name": "curl-wget",
        "action": "WEIGH",
        "weight": 3,
        "user_agent": "(?i:^curl/|^Wget/|^HTTPie/|^fetch/)"
    },
    {
        "name": "missing-accept",
        "action": "WEIGH",
        "weight": 3,
        "headers": { "Accept": "^$" }
    },
    {
        "name": "missing-accept-language",
        "action": "WEIGH",
        "weight": 2,
        "headers": { "Accept-Language": "^$" }
    },
    {
        "name": "connection-close",
        "action": "WEIGH",
        "weight": 2,
        "headers": { "Connection": "(?i:^close$)" }
    },
    {
        "name": "wildcard-accept-only",
        "action": "WEIGH",
        "weight": 2,
        "headers": { "Accept": "^\\*/\\*$" }
    },
    {
        "name": "no-accept-encoding",
        "action": "WEIGH",
        "weight": 2,
        "headers": { "Accept-Encoding": "^$" }
    },
    {
        "name": "automation-headers",
        "action": "WEIGH",
        "weight": 4,
        "headers": { "X-Requested-With": "(?i:scrapy|selenium|webdriver)" }
    }
]
